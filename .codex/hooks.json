{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/x2-v5-console-harness/scripts/verify_v5_harness.mjs",
            "timeout": 10,
            "statusMessage": "Checking PhysicalWorks v5 Design Harness"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/x2-v5-console-harness/scripts/verify_v5_harness.mjs",
            "timeout": 30,
            "statusMessage": "Design & Left-Rail Harness Gate"
          }
        ]
      }
    ]
  }
}
