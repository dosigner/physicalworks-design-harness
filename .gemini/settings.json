{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "name": "v5-core-freeze",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/.agents/skills/x2-v5-console-harness/scripts/guard_core_freeze.mjs\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "v5-harness-completion",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/.agents/skills/x2-v5-console-harness/scripts/verify_v5_harness.mjs\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
